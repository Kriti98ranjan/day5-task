
echo ""
echo "Running pre-commit checks..."
echo "=============================="

# STEP 1: Prettier check
echo "Step 1/3: Checking formatting..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "BLOCKED: Fix formatting first — run: npm run format"
  exit 1
fi
echo "Formatting OK"

# STEP 2: ESLint check
echo "Step 2/3: Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "BLOCKED: Fix lint errors before committing"
  exit 1
fi
echo "Lint OK"

# STEP 3: validate.sh
echo "Step 3/3: Running validate.sh..."
bash validate.sh
if [ $? -ne 0 ]; then
  echo "BLOCKED: Validation failed — check logs/validate.log"
  exit 1
fi
echo "Validation OK"

echo ""
echo "ALL CHECKS PASSED — committing!"
echo ""
